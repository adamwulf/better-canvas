{
  "manifest_version": 3,
  "name": "Better Canvas (Rice)",
  "version": "0.2.0",
  "description": "Personal quality-of-life tweaks for canvas.rice.edu, plus actions to freeze-dry any webpage as a self-contained .html snapshot or export it as Markdown.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Better Canvas",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/serviceworker.js"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["*://canvas.rice.edu/*"],
      "js": ["src/favicon/favicon.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://canvas.rice.edu/",
        "*://canvas.rice.edu/?*",
        "*://canvas.rice.edu/dashboard",
        "*://canvas.rice.edu/dashboard?*"
      ],
      "js": ["src/lib/terms.js", "src/dashboard/dashboard.js"],
      "css": ["src/dashboard/dashboard.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/canvas-favicon-16.png",
        "assets/canvas-favicon-32.png",
        "assets/canvas-favicon-48.png"
      ],
      "matches": ["*://canvas.rice.edu/*"]
    },
    {
      "resources": ["src/vendor/freeze-dry.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
