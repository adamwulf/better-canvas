{
  "manifest_version": 3,
  "name": "Better Canvas (Rice)",
  "version": "0.7.0",
  "description": "Personal quality-of-life tweaks for Canvas and the Esther course roster.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://canvas.rice.edu/*", "*://hq.globaltech.org/*"],
      "js": ["src/favicon/favicon.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://canvas.rice.edu/",
        "*://canvas.rice.edu/?*",
        "*://canvas.rice.edu/dashboard",
        "*://canvas.rice.edu/dashboard?*",
        "*://hq.globaltech.org/",
        "*://hq.globaltech.org/?*",
        "*://hq.globaltech.org/dashboard",
        "*://hq.globaltech.org/dashboard?*"
      ],
      "js": ["src/lib/terms.js", "src/lib/grouping.js", "src/dashboard/dashboard.js"],
      "css": ["src/dashboard/dashboard.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://canvas.rice.edu/*", "*://hq.globaltech.org/*"],
      "js": ["src/lib/terms.js", "src/lib/grouping.js", "src/tray/course-tray.js"],
      "css": ["src/tray/course-tray.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://canvas.rice.edu/files*",
        "*://canvas.rice.edu/courses/*/files*",
        "*://canvas.rice.edu/groups/*/files*",
        "*://canvas.rice.edu/users/*/files*",
        "*://hq.globaltech.org/files*",
        "*://hq.globaltech.org/courses/*/files*",
        "*://hq.globaltech.org/groups/*/files*",
        "*://hq.globaltech.org/users/*/files*"
      ],
      "js": ["src/files/column-resize.js"],
      "css": ["src/files/column-resize.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://esther.rice.edu/selfserve/swkrost*"],
      "js": ["src/flashcards/flashcards.js"],
      "css": ["src/flashcards/flashcards.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/canvas-favicon-16.png",
        "assets/canvas-favicon-32.png",
        "assets/canvas-favicon-48.png"
      ],
      "matches": ["*://canvas.rice.edu/*", "*://hq.globaltech.org/*"]
    }
  ]
}
